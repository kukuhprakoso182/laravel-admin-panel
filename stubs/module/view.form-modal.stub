<form @submit.prevent="submitForm()">
    <x-molecules.modal show="showFormModal">

        <x-slot:title>
            <span x-text="isEdit ? 'Edit __CLASS__' : 'Tambah __CLASS__'"></span>
        </x-slot:title>

        <div class="space-y-4">
            <x-atoms.input
                type="text"
                name="name"
                label="Nama"
                x-model="form.name"
                errors-var="errors"
            />
        </div>

        <x-slot:footer>
            <x-molecules.modal-form-actions show="showFormModal" createLabel="Tambah __CLASS__" />
        </x-slot:footer>

    </x-molecules.modal>
</form>
